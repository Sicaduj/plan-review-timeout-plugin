{
  "name": "@deepseek-ai/dsh-experimental-plan-review-timeout",
  "version": "1.0.2",
  "description": "Configurable exit_plan_mode plan-review timeout for the Plugins settings page",
  "type": "module",
  "author": "Sicaduj",
  "homepage": "https://github.com/Sicaduj/plan-review-timeout-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sicaduj/plan-review-timeout-plugin.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "plan-mode",
    "exit-plan-mode",
    "plan-review",
    "timeout"
  ],
  "engines": {
    "dsh": "*"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "generate:typert": "node scripts/generate-typert.mjs",
    "compile": "tsc -b tsconfig.json",
    "bundle": "tsdown --config-loader native",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-timeout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.19.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-config-editor": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "immer": "^10.1.1",
    "react": "^18.2.0",
    "tsdown": "file:../deepseek-harness/node_modules/tsdown",
    "typescript": "file:../deepseek-harness/node_modules/typescript",
    "zustand": "~4.5.7"
  },
  "license": "MIT"
}
